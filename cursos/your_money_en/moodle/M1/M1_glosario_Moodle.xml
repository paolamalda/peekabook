<GLOSSARY><INFO><NAME>Key words · M1</NAME><INTRO>What the course terms mean, in plain words.</INTRO><INTROFORMAT>1</INTROFORMAT><ALLOWDUPLICATEDENTRIES>0</ALLOWDUPLICATEDENTRIES><DISPLAYFORMAT>dictionary</DISPLAYFORMAT><SHOWSPECIAL>1</SHOWSPECIAL><SHOWALPHABET>1</SHOWALPHABET><SHOWALL>1</SHOWALL><ALLOWCOMMENTS>0</ALLOWCOMMENTS><USEDYNALINK>0</USEDYNALINK><DEFAULTAPPROVAL>1</DEFAULTAPPROVAL><GLOBALGLOSSARY>0</GLOBALGLOSSARY><ENTBYPAGE>20</ENTBYPAGE><ENTRIES>
<ENTRY><CONCEPT>1099 form</CONCEPT><DEFINITION>A form some companies or apps send to tell the IRS how much they paid you.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Accredited representative</CONCEPT><DEFINITION>A person authorized by the Department of Justice to give immigration advice at a recognized organization.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>APR</CONCEPT><DEFINITION>The yearly cost of a loan, calculated with official rules. It&#x27;s for comparing loans.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>APY</CONCEPT><DEFINITION>What your savings earn in a year, counting that interest also earns interest.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Available balance</CONCEPT><DEFINITION>What the bank lets you use today. It may not include payments you made that haven&#x27;t been charged yet.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Budget</CONCEPT><DEFINITION>The plan for where your money will go before you spend it.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Buying power</CONCEPT><DEFINITION>What your money can buy. If prices go up and your pay doesn&#x27;t, it goes down.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>CalEITC</CONCEPT><DEFINITION>A California credit for people who work and have low incomes. You can claim it with an ITIN.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Cash</CONCEPT><DEFINITION>Bills and coins you have in your hand.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Cash flow</CONCEPT><DEFINITION>How your money comes in and goes out over time, day by day or week by week.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Certifying Acceptance Agent</CONCEPT><DEFINITION>A person or business authorized by the IRS to review your ITIN documents so you don&#x27;t have to mail the originals.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Community health centers</CONCEPT><DEFINITION>Clinics that serve anyone regardless of immigration status and charge based on your income.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Compound interest</CONCEPT><DEFINITION>Interest that is added to the balance and then also earns interest. It grows faster and faster.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Credit</CONCEPT><DEFINITION>A card that pays with money the bank lends you; if you don&#x27;t pay it all on time, they charge interest.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>CTEC</CONCEPT><DEFINITION>The California registry where people who prepare taxes for pay must register if they aren&#x27;t accountants, enrolled agents or attorneys.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Debit</CONCEPT><DEFINITION>A card that pays with your own money from your account.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Deduction</CONCEPT><DEFINITION>An amount subtracted from your income before the tax is calculated. It lowers what you pay a little.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Deficit</CONCEPT><DEFINITION>When what you need to pay is more than what you have.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Deposit</CONCEPT><DEFINITION>Money you keep at a bank or credit union. They owe it to you and give it back when you ask.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Earned income</CONCEPT><DEFINITION>Money you are paid for your work, or what is left from your sales. It&#x27;s yours to spend.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>EDD</CONCEPT><DEFINITION>California Employment Development Department: unemployment, disability and payroll taxes.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Effective rate</CONCEPT><DEFINITION>The percentage of tax you actually pay on all your income.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Emergency fund</CONCEPT><DEFINITION>Money you set aside only for surprises, like an illness or losing work hours.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Estimated payments</CONCEPT><DEFINITION>Tax payments you make several times a year when nobody takes them out of your pay.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Exchange rate</CONCEPT><DEFINITION>What one currency costs in another. For example, how many pesos you get for one dollar.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>FTB</CONCEPT><DEFINITION>Franchise Tax Board: California&#x27;s state tax agency.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Gross income</CONCEPT><DEFINITION>What you earned before taxes and other deductions are taken out.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Inflation</CONCEPT><DEFINITION>When almost everything costs more than before. The same money buys less.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>ITIN</CONCEPT><DEFINITION>A number the IRS gives people who can&#x27;t get an SSN so they can pay taxes. It doesn&#x27;t give permission to work.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Job classification</CONCEPT><DEFINITION>Whether you are an employee or an independent worker under the law. It changes your rights and how you pay taxes.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Latte factor</CONCEPT><DEFINITION>A small purchase you make many times, like a daily soda or coffee, that adds up to a lot.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Loan</CONCEPT><DEFINITION>Money someone gives you today that you have to pay back later, sometimes with an extra cost.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Net income</CONCEPT><DEFINITION>What is actually deposited after deductions.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Net worth</CONCEPT><DEFINITION>What is really yours: everything you have minus everything you owe.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Opportunity cost</CONCEPT><DEFINITION>What you give up having or doing when you choose something else with your money or your time.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Overdraft</CONCEPT><DEFINITION>When you pay more than you have and the bank covers it, but charges you a fee.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Payroll advance</CONCEPT><DEFINITION>Apps or employers that give you part of your future pay today. It comes out of your next paycheck, and sometimes there&#x27;s a fee.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Percentage points</CONCEPT><DEFINITION>The direct difference between two percentages. From 3% to 5% is 2 points.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Principal</CONCEPT><DEFINITION>The amount you borrowed or saved, not counting interest.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>PTIN</CONCEPT><DEFINITION>A number the IRS gives every person who prepares tax returns for pay.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Public charge</CONCEPT><DEFINITION>A review the government does in some immigration cases to see whether a person might depend mainly on government benefits.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Refund</CONCEPT><DEFINITION>Money you get back for something you already paid, like when you return a pair of shoes.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Scope of service</CONCEPT><DEFINITION>Everything the price includes: which tasks they do and which cost extra.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Simple interest</CONCEPT><DEFINITION>Interest that is always calculated on the amount you borrowed or saved at the start.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Tax credit</CONCEPT><DEFINITION>An amount subtracted directly from your tax. Some give you money even if you owe nothing.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Tax return</CONCEPT><DEFINITION>The document you send the government each year with what you earned, to calculate how much tax you owe.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>TCE</CONCEPT><DEFINITION>Tax Counseling for the Elderly: no-cost IRS tax help, mainly for people 60 and older.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>VITA</CONCEPT><DEFINITION>Volunteer Income Tax Assistance: an IRS program that prepares tax returns at no cost for people with low or moderate income.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>WIC</CONCEPT><DEFINITION>Nutrition program for pregnant women, infants and children under 5.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Withholding</CONCEPT><DEFINITION>Money your employer takes out of your pay and sends to the government as an advance on your taxes.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>YCTC</CONCEPT><DEFINITION>California Young Child Tax Credit, for families with children under 6.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Young Child Tax Credit</CONCEPT><DEFINITION>An extra California credit if you qualify for CalEITC and have a child under 6.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
</ENTRIES></INFO></GLOSSARY>