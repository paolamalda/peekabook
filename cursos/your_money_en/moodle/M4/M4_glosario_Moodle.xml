<GLOSSARY><INFO><NAME>Key words · M4</NAME><INTRO>What the course terms mean, in plain words.</INTRO><INTROFORMAT>1</INTROFORMAT><ALLOWDUPLICATEDENTRIES>0</ALLOWDUPLICATEDENTRIES><DISPLAYFORMAT>dictionary</DISPLAYFORMAT><SHOWSPECIAL>1</SHOWSPECIAL><SHOWALPHABET>1</SHOWALPHABET><SHOWALL>1</SHOWALL><ALLOWCOMMENTS>0</ALLOWCOMMENTS><USEDYNALINK>0</USEDYNALINK><DEFAULTAPPROVAL>1</DEFAULTAPPROVAL><GLOBALGLOSSARY>0</GLOBALGLOSSARY><ENTBYPAGE>20</ENTBYPAGE><ENTRIES>
<ENTRY><CONCEPT>Accredited representatives</CONCEPT><DEFINITION>People authorized by the Department of Justice to give immigration advice within a recognized organization.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Caregiver&#x27;s Authorization Affidavit</CONCEPT><DEFINITION>A California form that lets a trusted adult enroll your children in school and authorize some medical care. It doesn&#x27;t change custody.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Coinsurance</CONCEPT><DEFINITION>The percentage of the bill you pay after the deductible.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Contingency plan</CONCEPT><DEFINITION>Steps you prepare calmly so you know what to do if an emergency comes.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Deductible</CONCEPT><DEFINITION>What you pay first, when something happens, before the insurance starts paying.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Drill</CONCEPT><DEFINITION>Practice with a made-up emergency to see if your plan works.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Durable financial power of attorney</CONCEPT><DEFINITION>A document that legally authorizes a person you trust to manage your money and pay your bills if you can&#x27;t, even if you&#x27;re incapacitated.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Emergency fund</CONCEPT><DEFINITION>Money set aside only for surprises, like an illness or losing work hours.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Exclusion</CONCEPT><DEFINITION>What the insurance doesn&#x27;t cover, even if you have a policy.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Explanation of benefits</CONCEPT><DEFINITION>A paper from the insurance explaining how it paid for care. It isn&#x27;t a bill.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Financial abuse</CONCEPT><DEFINITION>When someone controls your money, your documents or your financial decisions to dominate you.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Freezing your credit</CONCEPT><DEFINITION>Blocking your report at no cost so nobody can open new accounts in your name.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Good Faith Estimate</CONCEPT><DEFINITION>A written estimate of the total cost of scheduled medical care, which you should get if you don&#x27;t have insurance.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Notary public</CONCEPT><DEFINITION>A person who only certifies signatures. In the U.S. they are not a lawyer and can&#x27;t give immigration advice.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Premium</CONCEPT><DEFINITION>What you pay each month or each year to have the insurance.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
</ENTRIES></INFO></GLOSSARY>