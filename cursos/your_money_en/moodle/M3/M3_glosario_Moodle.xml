<GLOSSARY><INFO><NAME>Key words · M3</NAME><INTRO>What the course terms mean, in plain words.</INTRO><INTROFORMAT>1</INTROFORMAT><ALLOWDUPLICATEDENTRIES>0</ALLOWDUPLICATEDENTRIES><DISPLAYFORMAT>dictionary</DISPLAYFORMAT><SHOWSPECIAL>1</SHOWSPECIAL><SHOWALPHABET>1</SHOWALPHABET><SHOWALL>1</SHOWALL><ALLOWCOMMENTS>0</ALLOWCOMMENTS><USEDYNALINK>0</USEDYNALINK><DEFAULTAPPROVAL>1</DEFAULTAPPROVAL><GLOBALGLOSSARY>0</GLOBALGLOSSARY><ENTBYPAGE>20</ENTBYPAGE><ENTRIES>
<ENTRY><CONCEPT>Ability to pay</CONCEPT><DEFINITION>What you can pay each month without leaving your basic expenses uncovered, even in a hard month.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>APR</CONCEPT><DEFINITION>Annual percentage rate: the yearly cost of credit, including interest and some fees.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Authorized user</CONCEPT><DEFINITION>A person who can use your credit card. You pay for what they spend.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Collateral</CONCEPT><DEFINITION>Something of value, like your car, that backs a debt. If you don&#x27;t pay, it can be taken.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Cosigner</CONCEPT><DEFINITION>A person who signs someone else&#x27;s loan and promises to pay it if that person doesn&#x27;t.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Cosigner notice</CONCEPT><DEFINITION>A form the lender must give you before you sign, explaining that you will have to pay if the other person doesn&#x27;t.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Credit report</CONCEPT><DEFINITION>A history of how you pay your debts. Banks review it to decide whether to lend to you.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Credit score</CONCEPT><DEFINITION>A number that sums up your history. The higher it is, the easier and cheaper it is to borrow.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Credit utilization</CONCEPT><DEFINITION>How much of your card limit you&#x27;re using. If you owe 300 on a 1,000 limit, you use 30%.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Debt list</CONCEPT><DEFINITION>A list of all your debts: who you owe, how much, how much you pay each month and when.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Debt-to-income ratio</CONCEPT><DEFINITION>What share of your income goes to paying debts each month.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>DFPI</CONCEPT><DEFINITION>California Department of Financial Protection and Innovation, which oversees lenders and debt collectors.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Dispute</CONCEPT><DEFINITION>A formal request for the agency to investigate and correct wrong information in your report.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Grace period</CONCEPT><DEFINITION>Time when you aren&#x27;t charged interest if you pay the full balance on time.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Lender</CONCEPT><DEFINITION>The bank, credit union, store or person lending the money.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Lending circle</CONCEPT><DEFINITION>A group that lends with no interest, like a tanda, but organized, and that reports your payments to the agencies.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Login information</CONCEPT><DEFINITION>Your username and password to get into your bank or app.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Minimum payment</CONCEPT><DEFINITION>The least you can pay on your card to avoid falling behind. If you only pay that, the debt takes years to go down.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Principal</CONCEPT><DEFINITION>The amount you were lent, not counting interest.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Refinance</CONCEPT><DEFINITION>Swap your debt for another with different terms, like another rate or term.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Refinanced</CONCEPT><DEFINITION>The loan is replaced with a new one, with other terms or in another person&#x27;s name.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Revolving credit</CONCEPT><DEFINITION>Credit you can use again as you pay it down, like a credit card.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Secured card</CONCEPT><DEFINITION>A credit card that asks for a deposit as backing. You pay your purchases like with any card.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Statute of limitations</CONCEPT><DEFINITION>The maximum time a creditor has to sue you in court over a debt.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Tanda</CONCEPT><DEFINITION>A group of people who each put in the same amount every week or month; taking turns, each one receives the total.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
<ENTRY><CONCEPT>Total cost</CONCEPT><DEFINITION>Everything you pay for a loan: the payments, the interest and the fees, added up.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>0</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>1</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY>
</ENTRIES></INFO></GLOSSARY>